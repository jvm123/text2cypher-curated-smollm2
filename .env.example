# Hugging Face resources
HF_MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
HF_DATASET_ID=RomanTeucher/text2cypher-curated
HF_SMOKE_SPLIT=test
HF_SMOKE_INDEX=0
MAX_SEQUENCE_LENGTH=1024
MAX_NEW_TOKENS=256
TORCH_NUM_THREADS=4
SEED=42
OUTPUT_DIR=outputs

# Set before running `make upload-model`; authenticate with `hf auth login`.
# HF_REPO_ID=your-account/smollm2-text2cypher

# Local Docker Neo4j defaults
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_VALIDATION_TIMEOUT=10
